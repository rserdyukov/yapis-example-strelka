// Массивы: индекс — int, массив целиком не присваивается, литерал массива —
// только в начальном значении, по ссылке (var) — только изменяемый массив.
// expect: E114 E134
machine M
const PRIMES: int[3] = [2, 3, 5]
context { a: int[3], b: int[3] }
events { e }
states S
initial S
terminal S
action fill(var x: int[3]) { x[0] = 1 }
action act {
  a[true] = 1
  a = b
  b[0] = [1, 2]
  fill(PRIMES)
}
S -- e --> / act
