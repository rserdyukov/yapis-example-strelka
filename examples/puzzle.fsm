// Волк, коза и капуста: головоломку решает компилятор.
//
// Состояние — кто на левом берегу, «_» — река: ФВК_Ц значит «фермер, волк и
// коза слева, капуста справа». Записаны только БЕЗОПАСНЫЕ состояния: без
// фермера волк не остаётся с козой, коза — с капустой. Ход, который ведёт в
// опасное состояние, — переход в Lost («кого-то съели»).
//
// Решать головоломку не нужно — нужно её описать. Остальное делают
// проверки, которые и так есть в компиляторе:
//   * E102 (обход в ширину от начального) — если бы решения не было,
//     состояние Done оказалось бы недостижимым и сборка упала бы;
//   * E103 — из каждого состояния, даже из Lost, есть путь к цели
//     (без `restart` из Lost сборка падает);
//   * E106 и W117 — ход в каждом состоянии описан ровно один раз;
//   * W108 — каждый ход в каждом состоянии продуман или явно невозможен;
//   * побочный продукт E102 — кратчайший путь до терминального состояния:
//
//   python3 -m fsmc examples/puzzle.fsm --emit paths
//   Puzzle: ФВКЦ_ ⇒ Done за 7 шаг(а): goat → alone → wolf → goat → cabbage → alone → goat
//
// Это и есть ответ. Сценарий puzzle.events проигрывает его.

machine Puzzle

events {
  alone      // фермер переплывает один
  wolf       // ... с волком
  goat       // ... с козой
  cabbage    // ... с капустой
  restart
}

states ФВКЦ_, ФВК_Ц, ФВЦ_К, ФКЦ_В, ВЦ_ФК, ФК_ВЦ, В_ФКЦ, К_ФВЦ, Ц_ФВК, Done, Lost
initial ФВКЦ_
terminal Done

action eaten(who: string)  { say "Съели ", who, ". Начните заново: restart" }
action boat(cargo: string) { say "Лодка: фермер", cargo }
action win                 { say "Все на правом берегу!" }
action again               { say "Заново" }
action no_cargo            { say "Этого пассажира нет на берегу фермера" }

ФВКЦ_ -- goat    ----> ВЦ_ФК / boat(" и коза")
ФВКЦ_ -- alone   ----> Lost  / eaten("козу или капусту")
ФВКЦ_ -- wolf    ----> Lost  / eaten("капусту")
ФВКЦ_ -- cabbage ----> Lost  / eaten("козу")

ВЦ_ФК -- alone   ----> ФВЦ_К / boat("")
ВЦ_ФК -- goat    ----> ФВКЦ_ / boat(" и коза")

ФВЦ_К -- wolf    ----> Ц_ФВК / boat(" и волк")
ФВЦ_К -- cabbage ----> В_ФКЦ / boat(" и капуста")
ФВЦ_К -- alone   ----> ВЦ_ФК / boat("")

Ц_ФВК -- goat    ----> ФКЦ_В / boat(" и коза")
Ц_ФВК -- wolf    ----> ФВЦ_К / boat(" и волк")
Ц_ФВК -- alone   ----> Lost  / eaten("козу")

В_ФКЦ -- goat    ----> ФВК_Ц / boat(" и коза")
В_ФКЦ -- cabbage ----> ФВЦ_К / boat(" и капуста")
В_ФКЦ -- alone   ----> Lost  / eaten("капусту")

ФКЦ_В -- cabbage ----> К_ФВЦ / boat(" и капуста")
ФКЦ_В -- goat    ----> Ц_ФВК / boat(" и коза")
ФКЦ_В -- alone   ----> Lost  / eaten("капусту")

ФВК_Ц -- wolf    ----> К_ФВЦ / boat(" и волк")
ФВК_Ц -- goat    ----> В_ФКЦ / boat(" и коза")
ФВК_Ц -- alone   ----> Lost  / eaten("козу")

К_ФВЦ -- alone   ----> ФК_ВЦ / boat("")
К_ФВЦ -- wolf    ----> ФВК_Ц / boat(" и волк")
К_ФВЦ -- cabbage ----> ФКЦ_В / boat(" и капуста")

ФК_ВЦ -- goat    ----> Done  / boat(" и коза"), win
ФК_ВЦ -- alone   ----> К_ФВЦ / boat("")

// Пассажира нет на берегу фермера — ход невозможен, автомат стоит.
ВЦ_ФК         -- wolf | cabbage ---> / no_cargo
ФВЦ_К         -- goat -------------> / no_cargo
Ц_ФВК         -- cabbage ----------> / no_cargo
В_ФКЦ         -- wolf -------------> / no_cargo
ФКЦ_В         -- wolf -------------> / no_cargo
ФВК_Ц         -- cabbage ----------> / no_cargo
К_ФВЦ         -- goat -------------> / no_cargo
ФК_ВЦ         -- wolf | cabbage ---> / no_cargo

// Из Lost — только заново; Done — финал, дальше ничего не происходит.
any  -- restart ----> ФВКЦ_ / again
Lost -- any           ignore
Done -- any           ignore
