# Три сообщения. Потери задаются заранее: lose — «следующий пакет канала
# пропадёт».
#
# 10 доходит сразу.
sender.put 10
# У 20 теряется пакет данных — отправитель ждёт и повторяет по таймеру.
fwd.lose
sender.put 20
sender.timeout
# У 30 теряется подтверждение — повтор приходит к получателю дубликатом,
# тот подтверждает ещё раз.
back.lose
sender.put 30
sender.timeout
# Пока отправитель ждёт, приходят ещё два сообщения — встают в очередь
# и уходят сами после подтверждения.
fwd.lose
sender.put 40
sender.put 50
sender.timeout
# Лишний таймер в Idle ничего не ломает.
sender.timeout
